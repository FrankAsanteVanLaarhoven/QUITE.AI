# Local deployment. Replace every secret before any shared or public host.
DATABASE_URL=postgres://quiet:quiet@127.0.0.1:5432/quiet
QUIET_SESSION_SECRET=replace-with-a-32-character-secret-minimum
QUIET_ADMIN_EMAIL=amara@harbourline.example
QUIET_ADMIN_PASSWORD=Harbourline-local-2026
QUIET_DEV_API_KEY=quiet_demo_harbourline_local_only
QUIET_SEED=demo
QUIET_ALLOW_DEMO_CREDENTIALS=true
QUIET_GATEWAY_MODE=decide
QUIET_COOKIE_SECURE=false
QUIET_WORKSPACE_NAME=Harbourline
# Optional live providers. Empty keys keep the gateway in an honest decide/fail path.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Optional trace export. Quiet boots without a collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
